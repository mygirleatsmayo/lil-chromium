{
  "manifest_version": 3,
  "name": "lil-chromium",
  "version": "0.3.0",
  "description": "Ephemeral lils (little popup windows) for lil-chromium, a Little Arc-style browser.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "history",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "webNavigation",
    "system.display",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sleep.html", "sleep.js", "assets/sleeping-lil-data.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "promote-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open this lil in the default browser"
    }
  }
}
