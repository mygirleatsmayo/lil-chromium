{
  "manifest_version": 3,
  "name": "lil-chromium",
  "version": "0.1.0",
  "description": "Ephemeral little windows for lil-chromium, a Little Arc-style browser.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "history",
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation",
    "system.display"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "promote-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open this little window as a Chrome tab"
    }
  }
}
