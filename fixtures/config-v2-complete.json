{
  "version": 2,
  "defaultBrowser": "helium",
  "fallbackBrowser": "chrome",
  "paletteAnchor": "top-center",
  "linkBehavior": "new-lil",
  "ephemeralDefault": "6h",
  "sleep": {
    "enabled": true,
    "afterMinutes": 45,
    "audioGuard": true,
    "formGuard": false,
    "tint": "#3311aa",
    "whitelist": ["mail.google.com"]
  },
  "searchEngine": {
    "name": "Kagi",
    "template": "https://kagi.com/search?q=%s"
  },
  "hoverBar": {
    "style": "solid",
    "tint": "#112233"
  },
  "knownBrowsers": [
    {"slug": "helium", "name": "Helium", "bundleId": "net.imput.helium", "installed": true},
    {"slug": "chrome", "name": "Google Chrome", "bundleId": "com.google.Chrome", "installed": true},
    {"slug": "vivaldi", "name": "Vivaldi", "bundleId": "com.vivaldi.Vivaldi", "installed": false}
  ]
}
